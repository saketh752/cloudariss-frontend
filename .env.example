# ==============================================================================
# Cloudariss Technologies — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to `.env` for local development.
# NEVER commit real passwords, tokens, or database credentials to version control.

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL Connections
# ------------------------------------------------------------------------------
# Transaction Pooler connection string (port 6543, pgbouncer=true) for runtime queries
DATABASE_URL="postgresql://postgres.project_ref:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection string (port 5432) for Prisma migrations and provisioning CLI
DIRECT_URL="postgresql://postgres.project_ref:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. Application Runtime & Exact-Match Origin Security
# ------------------------------------------------------------------------------
NODE_ENV="development"
PORT="4000"

# CORS_ORIGIN must be ONE exact trusted application origin (scheme + host + optional port).
# Compared using strict string equality (===). Never use wildcards (*), substrings, or reflected origins.
# - Local development example:  CORS_ORIGIN="http://localhost:5173"
# - Production example:         CORS_ORIGIN="https://cloudariss-frontend.vercel.app" (or "https://cloudariss.com")
CORS_ORIGIN="http://localhost:5173"

# Session lifetime in hours (Production cookie uses __Host-cld_admin_sid; local dev uses cld_admin_sid)
SESSION_TTL_HOURS="12"

# ------------------------------------------------------------------------------
# 3. Controlled Admin Provisioning CLI (`npm run admin:provision`)
# ------------------------------------------------------------------------------
# Used ONLY by `scripts/provision-admins.ts` to create missing Super Admin accounts.
# Existing accounts are never overwritten automatically.
ADMIN_CEO_NAME="CEO"
ADMIN_CEO_EMAIL="ceo@placeholder.cloudariss.com"
ADMIN_CEO_INITIAL_PASSWORD="CHANGE_ME_STRONG_PASSWORD_1"

ADMIN_COFOUNDER_NAME="Co-Founder"
ADMIN_COFOUNDER_EMAIL="cofounder@placeholder.cloudariss.com"
ADMIN_COFOUNDER_INITIAL_PASSWORD="CHANGE_ME_STRONG_PASSWORD_2"

ADMIN_WEBADMIN_NAME="Website Administrator"
ADMIN_WEBADMIN_EMAIL="admin@placeholder.cloudariss.com"
ADMIN_WEBADMIN_INITIAL_PASSWORD="CHANGE_ME_STRONG_PASSWORD_3"

